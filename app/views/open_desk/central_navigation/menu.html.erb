<%= turbo_frame_tag "opendesk-central-navigation" do %>
  <% @entries.each do |group| %>
    <%= render Primer::Alpha::ActionList.new(classes: "op-opendesk-navigation--group") do |list| %>
      <% if group.name.present? %>
        <% list.with_heading(
             title: group.name,
             align_items: :flex_start,
             classes: "op-opendesk-navigation--item-header"
           ) %>
      <% end %>

      <% group.items.each do |item| %>
        <% list.with_item(
          href: item.link,
          label: nil,
          test_selector: "op-menu--item-action",
          classes: "op-opendesk-navigation--item op-opendesk-navigation--item-link op-menu--item-action"
        ) do |menu_item| %>
          <div class="op-opendesk-navigation--item-content d-flex align-items-center gap-2">
            <% if item.icon.present? %>
              <%= tag.img src: item.icon,
                          class: "op-opendesk-navigation--item-icon",
                          alt: "",
                          aria: { hidden: true },
                          role: "presentation" %>
            <% end %>
            <span> <%= item.name %> </span>
          </div>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
